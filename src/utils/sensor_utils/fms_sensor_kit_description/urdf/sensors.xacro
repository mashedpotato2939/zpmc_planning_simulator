<?xml version="1.0"?>
<robot name="vehicle" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="config_dir" default="$(find fms_sensor_kit_description)/config"/>
  <xacro:include filename="sensor_kit.xacro"/>
  <xacro:sensor_kit_macro parent="base_link"
    x="0.9" y="0.0" z="2.0" roll="0.0" pitch="0.0" yaw="0.0"/>
</robot>
