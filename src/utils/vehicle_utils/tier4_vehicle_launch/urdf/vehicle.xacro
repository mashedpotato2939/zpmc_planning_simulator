<?xml version="1.0"?>
<robot name="vehicle" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="vehicle_model" default=""/>
  <xacro:arg name="sensor_model" default=""/>

  <!-- vehicle -->
  <xacro:property name="vehicle_model_property" value="$(arg vehicle_model)"/>
  <xacro:include filename="$(optenv ROS_WORKSPACE /igv)/install/$(arg vehicle_model)_description/share/$(arg vehicle_model)_description/urdf/vehicle.xacro"/>

  <!-- sensors -->
  <xacro:property name="sensor_model_property" value="$(arg sensor_model)"/>
  <xacro:include filename="$(optenv ROS_WORKSPACE /igv)/install/$(arg sensor_model)_description/share/$(arg sensor_model)_description/urdf/sensors.xacro"/>
</robot>
