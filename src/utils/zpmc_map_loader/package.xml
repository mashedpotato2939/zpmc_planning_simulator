<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zpmc_map_loader</name>
  <version>1.0.0</version>
  <description>ZPMC HD Map loader node and client library for Autoware integration</description>
  <maintainer email="dev@zpmc.com">ZPMC</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>zpmc_map_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>

  <build_depend>pugixml</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
