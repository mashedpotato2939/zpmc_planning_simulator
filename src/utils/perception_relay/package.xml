<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>perception_relay</name>
  <version>1.0.0</version>
  <description>
    Perception message relay for real vehicle operation.
    Converts perception messages from autoware_auto_perception_msgs (Galactic)
    to autoware_perception_msgs (Humble) format for cross-version compatibility.
  </description>
  <maintainer email="maolinrun@zpmc.com">ZPMC Autonomous</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>autoware_auto_perception_msgs</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>unique_identifier_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
