<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>igv_path_planner</name>
  <version>1.0.0</version>
  <description>FMS path planner: converts FMS route windows / paths into an Autoware Path (maneuver detection, HD-map snapping, reverse handling, FMS uplink)</description>
  <maintainer email="developer@zpmc.com">ZPMC Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>autoware_planning_msgs</depend>
  <depend>autoware_perception_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>nlohmann_json</depend>
  <depend>unique_identifier_msgs</depend>
  <depend>reverse_vehicle_msg</depend>
  <depend>autoware_map_msgs</depend>
  <depend>autoware_lanelet2_extension</depend>
  <depend>lanelet2_core</depend>
  <depend>igv_planning_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>autoware_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
