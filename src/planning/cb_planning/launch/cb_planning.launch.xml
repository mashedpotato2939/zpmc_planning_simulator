<launch>
  <arg name="use_simulator" default="true" />
  <arg name="rviz_config" default="$(find-pkg-share cb_planning)/rviz/cb_planning.rviz"/>
  
  <!-- engage_transition_manager -->
  <node pkg="cb_planning" exec="planning_exe" name="planning_exe" output="screen">
    <remap from="input/kinematics" to="/localization/kinematic_state"/>
    <remap from="output/trajectory" to="/planning/scenario_planning/trajectory"/>
  </node>

  <group if="$(var use_simulator)">
    <node pkg="cb_planning" exec="vehicle_sim_exe" name="vehicle_sim" output="screen"> 
      <remap from="output/kinematics" to="/localization/kinematic_state"/>
      <remap from="input/trajectory" to="/planning/scenario_planning/trajectory"/>
      <remap from="/input/upper_test" to="/sim/sync"/>
    </node>
  </group>

  <group>
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" args="-d $(var rviz_config)">
      <env name="QT_QPA_PLATFORMTHEME" value="qt5ct"/>
    </node>
  </group> 
  
</launch>