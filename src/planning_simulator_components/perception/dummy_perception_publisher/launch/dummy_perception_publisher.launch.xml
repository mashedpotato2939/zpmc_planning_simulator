<?xml version="1.0"?>
<launch>
  <!-- dummy detection and sensor data -->
  <arg name="visible_range" default="300.0"/>
  <arg name="real" default="true"/>
  <arg name="use_object_recognition" default="true"/>
  <arg name="use_base_link_z" default="true"/>
  <arg name="remap_to_dummy_prefix" default="false" description="When true, remap perception topics to /dummy/perception/... for testing perception relay"/>

  <!-- Define topic prefixes based on remap_to_dummy_prefix flag -->
  <let name="perception_prefix" value="/dummy/perception" if="$(var remap_to_dummy_prefix)"/>
  <let name="perception_prefix" value="/perception" unless="$(var remap_to_dummy_prefix)"/>

  <group>
    <push-ros-namespace namespace="simulation"/>
    <group if="$(var real)">
      <node pkg="dummy_perception_publisher" exec="dummy_perception_publisher_node" name="dummy_perception_publisher" output="screen">
        <remap from="output/dynamic_object" to="$(var perception_prefix)/object_recognition/detection/labeled_clusters"/>
        <remap from="output/objects_pose" to="debug/object_pose"/>
        <remap from="output/points_raw" to="$(var perception_prefix)/obstacle_segmentation/pointcloud"/>
        <remap from="input/object" to="dummy_perception_publisher/object_info"/>
        <remap from="input/reset" to="input/reset"/>
        <param name="visible_range" value="$(var visible_range)"/>
        <param name="detection_successful_rate" value="0.999"/>
        <param name="enable_ray_tracing" value="false"/>
        <param name="use_object_recognition" value="$(var use_object_recognition)"/>
        <param name="object_centric_pointcloud" value="false"/>
        <param name="use_base_link_z" value="$(var use_base_link_z)"/>
        <param name="publish_ground_truth" value="true"/>
        <remap from="output/debug/ground_truth_objects" to="debug/ground_truth_objects"/>
      </node>
      <include file="$(find-pkg-share autoware_shape_estimation)/launch/shape_estimation.launch.xml">
        <arg name="input/objects" value="$(var perception_prefix)/object_recognition/detection/labeled_clusters"/>
        <arg name="output/objects" value="$(var perception_prefix)/object_recognition/detection/objects_with_feature"/>
      </include>
    </group>
    <group unless="$(var real)">
      <node pkg="dummy_perception_publisher" exec="dummy_perception_publisher_node" name="dummy_perception_publisher" output="screen">
        <remap from="output/dynamic_object" to="$(var perception_prefix)/object_recognition/detection/objects_with_feature"/>
        <remap from="output/objects_pose" to="debug/object_pose"/>
        <remap from="output/points_raw" to="$(var perception_prefix)/obstacle_segmentation/pointcloud"/>
        <remap from="input/object" to="dummy_perception_publisher/object_info"/>
        <remap from="input/reset" to="input/reset"/>
        <param name="visible_range" value="$(var visible_range)"/>
        <param name="detection_successful_rate" value="1.0"/>
        <param name="enable_ray_tracing" value="false"/>
        <param name="use_object_recognition" value="$(var use_object_recognition)"/>
        <param name="use_base_link_z" value="$(var use_base_link_z)"/>
      </node>
    </group>

    <!-- convert DynamicObjectsWithFeatureArray to DynamicObjects -->
    <include file="$(find-pkg-share autoware_detected_object_feature_remover)/launch/detected_object_feature_remover.launch.xml">
      <arg name="input" value="$(var perception_prefix)/object_recognition/detection/objects_with_feature"/>
      <arg name="output" value="$(var perception_prefix)/object_recognition/detection/objects"/>
    </include>
  </group>
</launch>
