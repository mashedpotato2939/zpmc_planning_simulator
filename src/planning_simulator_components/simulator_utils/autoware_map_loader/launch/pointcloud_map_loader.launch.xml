<launch>
  <arg name="pointcloud_map_path"/>
  <arg name="pointcloud_map_metadata_path"/>
  <arg name="pointcloud_map_loader_param_path" default="$(find-pkg-share autoware_map_loader)/config/pointcloud_map_loader.param.yaml"/>
  <arg name="pointcloud_map_topic" default="pointcloud_map"/>
  <arg name="get_partial_pcd_map_service" default="get_partial_pointcloud_map"/>
  <arg name="get_selected_pcd_map_service" default="get_selected_pointcloud_map"/>

  <node pkg="autoware_map_loader" exec="autoware_pointcloud_map_loader" name="pointcloud_map_loader_humble" output="both">
    <remap from="output/pointcloud_map" to="$(var pointcloud_map_topic)"/>
    <remap from="service/get_partial_pcd_map" to="$(var get_partial_pcd_map_service)"/>
    <remap from="service/get_selected_pcd_map" to="$(var get_selected_pcd_map_service)"/>
    <param from="$(var pointcloud_map_loader_param_path)" allow_substs="true"/>
  </node>
</launch>
